{
    "version": 8,
    "configurePresets": [
        {
            "name": "linux-x64",
            "displayName": "G++ x86_64-linux",
            "description": "Using compilers: C++ = g++",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}